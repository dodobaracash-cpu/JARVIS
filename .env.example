# --- Database -------------------------------------------------------------
# From your Supabase project: Settings → API.
SUPABASE_URL=https://your-project.supabase.co
# Server-side only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Model ----------------------------------------------------------------
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
# Optional override; defaults to claude-sonnet-5.
# JARVIS_MODEL=claude-sonnet-5

# --- Embeddings -----------------------------------------------------------
# `hashing` (default) needs no API key and matches on lexical overlap only.
# `openai` gives real semantic similarity and needs OPENAI_API_KEY.
EMBEDDING_PROVIDER=hashing
# OPENAI_API_KEY=sk-...

# --- User -----------------------------------------------------------------
# v0.1 is single-user; this names the one row in `users`.
JARVIS_USER_NAME=Cash
JARVIS_TIMEZONE=America/New_York
